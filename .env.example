# Triagely — environment configuration
#
# Everything has a sane default and the app runs fully without an API key:
# the deterministic triage engine (keyword classification, sentiment, urgency,
# priority scoring, SLA policy, template draft replies) works out of the box.
#
# Set LLM_API_KEY to upgrade the engine with model-based refinement: it keeps
# the heuristic results and lets the model write a personalized draft reply +
# summary when it disagrees with the deterministic classification.

NODE_ENV=development

# Durable storage. Leave blank to use the local JSON file store (./data).
# Set to a Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, ...)
# to persist to the database instead. Required for durability on serverless hosts,
# whose filesystem is read-only.
DATABASE_URL=

# OpenAI-compatible chat endpoint (Azure, vLLM, Groq, ... all work).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# When the heuristic engine is confident enough ({category, priority}, in 0-1),
# the LLM pass is skipped to save cost and latency.
LLM_CONFIDENCE_THRESHOLD=0.85

# Support org branding used in automated replies.
SUPPORT_ORG=Triagely
SUPPORT_SIGNATURE=The Triagely Support Team

# --- Auth -------------------------------------------------------------------
# Secret used to sign session cookies (HMAC-SHA256). REQUIRED in production;
# without it a dev default is used and a warning is logged.
AUTH_SECRET=

# Bootstrap admin, seeded on first sign-in when no accounts exist. If unset the
# default is admin@triagely.app / triagely-admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Triagely Admin

# --- Email ------------------------------------------------------------------
# Outbound replies. Leave RESEND_API_KEY blank to run in dry-run mode (replies
# are recorded in the audit trail but not sent).
RESEND_API_KEY=
EMAIL_FROM=Triagely <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Shared secret for the inbound email webhook (/api/inbound/email). Sent by the
# provider as `x-triagely-signature` or `Authorization: Bearer <secret>`.
INBOUND_WEBHOOK_SECRET=

# Optional bootstrap API key (admin) for the public /api/v1 surface. When set,
# it is accepted as an API key without a database write — handy for provisioning.
API_BOOTSTRAP_KEY=